SITE_URL=http://localhost:3000
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Password for every demo account created by the seed (admin, vendors, customers)
SEED_PASSWORD=choose-a-demo-password
# MongoDB connection string, e.g. from MongoDB Atlas. Never commit the real value.
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/
# Database name inside the cluster
MONGODB_DB=curio_store
